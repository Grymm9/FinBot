# =============================================================
# FinanceBot environment configuration
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` — it is gitignored.
# =============================================================

# --- Akahu (NZ Open Finance API) -----------------------------
# Get an app token + personal app token at https://my.akahu.nz
#  - AKAHU_APP_TOKEN: your application token (app token)
#  - AKAHU_USER_TOKEN: personal access token for your own account
AKAHU_APP_TOKEN=app_token_xxxxxxxxxxxxxxxx
AKAHU_USER_TOKEN=user_token_xxxxxxxxxxxxxxxx

# --- DeepSeek AI ----------------------------------------------
# Sign up at https://platform.deepseek.com to get an API key.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OpenAI-compatible base URL. Defaults to https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model id. "deepseek-chat" is the standard chat/V4 model.
DEEPSEEK_MODEL=deepseek-chat

# --- Discord Alerts (optional phone notifications) -----------
# Create a webhook in a Discord channel and paste the URL here.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# --- Income cycle / alert tuning ------------------------------
# Day of month your income lands (used to define the cycle).
INCOME_CYCLE_DAY=15
# Evaluate budget pacing up to and including this day of month.
BUDGET_CHECK_DAY=15
# Fire an alert when projected month-end spend exceeds this
# fraction of the category budget (0.0 - 1.0). 0.8 = 80%.
ALERT_SPEND_RATIO=0.8
