# =============================================================
# FinanceBot environment configuration
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` — it is gitignored.
# =============================================================

# --- Akahu (NZ Open Finance API) -----------------------------
# Get an app token + personal app token at https://my.akahu.nz
#  - AKAHU_APP_TOKEN: your application token (app token)
#  - AKAHU_USER_TOKEN: personal access token for your own account
AKAHU_APP_TOKEN=app_token_xxxxxxxxxxxxxxxx
AKAHU_USER_TOKEN=user_token_xxxxxxxxxxxxxxxx

# --- AI advisor (optional) -------------------------------------
# Pick a provider: deepseek | openai | anthropic | gemini | custom
# Keys: platform.deepseek.com, platform.openai.com/api-keys,
#       console.anthropic.com, aistudio.google.com/apikey
AI_PROVIDER=deepseek
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Leave blank to use the provider default:
#   DeepSeek  https://api.deepseek.com
#   OpenAI    https://api.openai.com/v1
#   Claude    https://api.anthropic.com/v1
#   Gemini    https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=
AI_MODEL=deepseek-chat
AI_REASONING_MODEL=deepseek-reasoner

# Legacy DeepSeek keys are still read when AI_PROVIDER=deepseek.
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# --- Discord Alerts (optional phone notifications) -----------
# Create a webhook in a Discord channel and paste the URL here.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# --- Income cycle / alert tuning ------------------------------
# Day of month your income lands (used to define the cycle).
INCOME_CYCLE_DAY=15
# Evaluate budget pacing up to and including this day of month.
BUDGET_CHECK_DAY=15
# Fire an alert when projected month-end spend exceeds this
# fraction of the category budget (0.0 - 1.0). 0.8 = 80%.
ALERT_SPEND_RATIO=0.8
